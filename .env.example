# Supabase project URL, available in Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable/anon key. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Used for canonical links and OAuth callback URL construction.
NEXT_PUBLIC_SITE_URL=http://localhost:3000